# --- Compose oficiales en bridge (Windows + Docker Desktop): en el arnés (un solo host) todo es local ---
# IP_PC3 = la de openldap en el bridge vlan99_infra: los contenedores de PC-1/PC-2 la alcanzan por la doble conexion de los overrides.
IP_PC3=10.10.99.10
IP_PC2=10.10.30.10
# Puertos publicados solo en localhost y desplazados, para no chocar entre PC-1 y PC-3 (ambos 8080) ni con 53/123 de Windows.
PUBLISH_IP=127.0.0.1
DNS_BIND_IP=127.0.0.1
OPENVPMS_PORT=18080
ERPNEXT_PORT=18081
PRETIX_PORT=18082
INVENTREE_PORT=18083
LDAP_PORT=1389
LDAPS_PORT=1636
DNS_PORT=1053
NTP_PORT=1123
