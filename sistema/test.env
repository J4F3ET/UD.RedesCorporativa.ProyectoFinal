OPENVPMS_DB_ROOT_PASSWORD=smoketest-openvpms
OPENVPMS_DB_PASSWORD=smoketest-openvpms-app
OPENVPMS_ADMIN_PASSWORD=Smoketest-Ovpms1!
PRETIX_DB_PASSWORD=smoketest-pretix
INVENTREE_DB_PASSWORD=smoketest-inventree
# SAMBA_ADMIN_PASSWORD (antes LDAP_ADMIN_PASSWORD): clave del Administrator del dominio AD.RESERVAVIVA.LAN, la fija
# "samba-tool domain provision" en el primer arranque de samba-ad. Debe cumplir la complejidad de AD (al menos 3 de
# 4 categorias de caracteres, longitud minima, y no contener el nombre de la cuenta): si samba-tool la rechaza, se
# cambia el valor aqui, nunca la politica del dominio.
SAMBA_ADMIN_PASSWORD=Smoketest-Samba1!
ERPNEXT_DB_ROOT_PASSWORD=smoketest-erpdb
ERPNEXT_ADMIN_PASSWORD=smoketest-erpadmin
INVENTREE_ADMIN_PASSWORD=smoketest-invadmin
PRETIX_ADMIN_EMAIL=admin@reservaviva.local
PRETIX_ADMIN_PASSWORD=smoketest-pxadmin
# --- LDAP/AD: UNICA fuente de las claves del directorio. servicios/samba-ad/sembrar.sh las usa para crear los
# usuarios y la cuenta de servicio en Samba AD (antes, levantar-sistema.sh preparar generaba con ellas el LDIF de
# OpenLDAP; ya no aplica). sembrar.sh las reconcilia en cada arranque: cambiar una aqui y ejecutar `arrancar` la aplica (un `restart` no relee el entorno); ver docs/seguridad.md (rotacion).
# svc-lectura es la cuenta de busqueda de InvenTree y ERPNext. Igual que arriba, deben cumplir la complejidad de AD;
# svc-lectura se cambio de valor porque "Svc-Lectura1" contenia el propio nombre de la cuenta (samba-tool lo rechaza).
LDAP_SVC_LECTURA_PASSWORD=Lectura-Servicio7!
LDAP_PRUEBA_VET_PASSWORD=Medica-Prueba1
LDAP_PRUEBA_LOGISTICA_PASSWORD=Oper-Prueba1
LDAP_PRUEBA_TAQUILLA_PASSWORD=Oper-Prueba1
LDAP_PRUEBA_RRHH_PASSWORD=Rrhh-Prueba1
# --- Direcciones y puertos. Todo el sistema corre en un solo host y se publica en UNA IP, la del equipo, con un puerto por servicio ---
# HOST_IP: la IP del equipo (la que el switch del laboratorio tiene asignada). En ella se publican las aplicaciones, el proxy,
# LDAP/LDAPS, DNS y NTP, y es a donde apuntan todos los nombres *.reservaviva.lan. Las aplicaciones se hablan entre si por
# HOST_IP:puerto. `levantar-sistema --ip X` la cambia solo para esa ejecucion y `--intranet` usa la IP de la LAN que detecte
# (para arrancar en un equipo que no tiene esta), sin tocar este fichero. Los puertos van desplazados: OpenVPMS y ERPNext
# escuchan ambos en 8080 dentro de su contenedor, y 53/udp y 123/udp suelen estar ocupados en Windows.
HOST_IP=192.168.1.26
OPENVPMS_PORT=18080
ERPNEXT_PORT=18081
PRETIX_PORT=18082
INVENTREE_PORT=18083
LDAP_PORT=1389
LDAPS_PORT=1636
DNS_PORT=1053
NTP_PORT=1123
# Proxy web por nombre (*.reservaviva.lan), publicado en HOST_IP:HTTP_PORT.
HTTP_PORT=80
