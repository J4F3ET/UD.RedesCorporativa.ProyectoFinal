OPENVPMS_DB_ROOT_PASSWORD=smoketest-openvpms
OPENVPMS_DB_PASSWORD=smoketest-openvpms-app
OPENVPMS_ADMIN_PASSWORD=Smoketest-Ovpms1!
PRETIX_DB_PASSWORD=smoketest-pretix
INVENTREE_DB_PASSWORD=smoketest-inventree
LDAP_ADMIN_PASSWORD=smoketest-ldap
ERPNEXT_DB_ROOT_PASSWORD=smoketest-erpdb
ERPNEXT_ADMIN_PASSWORD=smoketest-erpadmin
INVENTREE_ADMIN_PASSWORD=smoketest-invadmin
PRETIX_ADMIN_EMAIL=admin@reservaviva.local
PRETIX_ADMIN_PASSWORD=smoketest-pxadmin
# --- LDAP: UNICA fuente de las claves del directorio. levantar-sistema.sh preparar genera con ellas (hash SSHA) los
# LDIF del primer arranque en servicios/openldap/generado/. Cambiarlas aqui NO cambia un directorio ya creado:
# ver docs/seguridad.md (rotacion). svc-lectura es la cuenta de busqueda de InvenTree y ERPNext.
LDAP_SVC_LECTURA_PASSWORD=Svc-Lectura1
LDAP_PRUEBA_VET_PASSWORD=Medica-Prueba1
LDAP_PRUEBA_LOGISTICA_PASSWORD=Oper-Prueba1
LDAP_PRUEBA_TAQUILLA_PASSWORD=Oper-Prueba1
LDAP_PRUEBA_RRHH_PASSWORD=Rrhh-Prueba1
# --- Direcciones y puertos. Todo el sistema corre en un solo host: cada VLAN es un bridge de Docker con su subred ---
# Puertos publicados solo en localhost y desplazados: OpenVPMS y ERPNext escuchan ambos en 8080 dentro de su contenedor,
# y 53/udp y 123/udp suelen estar ocupados en Windows.
PUBLISH_IP=127.0.0.1
DNS_BIND_IP=127.0.0.1
OPENVPMS_PORT=18080
ERPNEXT_PORT=18081
PRETIX_PORT=18082
INVENTREE_PORT=18083
LDAP_PORT=1389
LDAPS_PORT=1636
DNS_PORT=1053
NTP_PORT=1123
# Proxy web por nombre (*.reservaviva.lan). INTRANET_IP es la IP en la que se publica el proxy (HTTP_PORT) y a la que
# apunta la vista "lan" del DNS. 127.0.0.1 = modo local. No se cambia aqui para abrir el sistema a la LAN: el modo
# intranet (levantar-sistema --intranet / -Intranet) exporta INTRANET_IP, DNS_BIND_IP y DNS_PORT=53 solo para esa
# ejecucion, sin tocar este fichero (docs/operacion.md, "Acceso desde la LAN").
INTRANET_IP=127.0.0.1
HTTP_PORT=80
