# --- Direcciones y puertos. Todo el sistema corre en un solo host: cada VLAN es un bridge de Docker con su subred ---
# Puertos publicados solo en localhost y desplazados: OpenVPMS y ERPNext escuchan ambos en 8080 dentro de su contenedor,
# y 53/udp y 123/udp suelen estar ocupados en Windows.
PUBLISH_IP=127.0.0.1
DNS_BIND_IP=127.0.0.1
OPENVPMS_PORT=18080
ERPNEXT_PORT=18081
PRETIX_PORT=18082
INVENTREE_PORT=18083
LDAP_PORT=1389
LDAPS_PORT=1636
DNS_PORT=1053
NTP_PORT=1123
