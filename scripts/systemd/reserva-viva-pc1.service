[Unit]
Description=Reserva Viva - PC-1 Servidor Medico (OpenVPMS)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Ajustar la ruta si el repositorio no está clonado en /opt/reserva-viva
WorkingDirectory=/opt/reserva-viva/docker/pc1-medica
ExecStart=/opt/reserva-viva/docker/pc1-medica/deploy.sh
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
