# Proxy web por nombre de Reserva Viva (contenedor proxy-web). Es una PLANTILLA: el entrypoint de la imagen oficial de
# nginx sustituye ${NET_INFRA} (los tres primeros octetos de vlan99_infra, 10.10.99 por defecto) y la escribe en
# /etc/nginx/conf.d/default.conf. Detalle y decisiones en README.md de esta carpeta.
#
# Un server por nombre. Cada uno llega a su aplicacion por la IP que esta tiene en vlan99_infra, la unica red del proxy:
#   openvpms.reservaviva.lan   -> openvpms-app ${NET_INFRA}.24:8080 (Tomcat; "/" redirige a /openvpms/)
#   pretix.reservaviva.lan     -> pretix-web   ${NET_INFRA}.21:80   (nginx + gunicorn de la imagen)
#   inventree.reservaviva.lan  -> inventree-app ${NET_INFRA}.22:8000 (gunicorn + whitenoise)
#   rrhh.reservaviva.lan       -> erpnext-hr   ${NET_INFRA}.25:8080 (nginx de ERPNext: /assets, socket.io y backend)
# Cualquier otro nombre (o una IP) cae en el default_server, que responde 404 con un texto que lo explica.

# WebSocket (socket.io de ERPNext): la cabecera Connection solo pasa a "upgrade" si el cliente lo pidio.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Comun a todos los server: el Host original (con el puerto, si lo hay) y las cabeceras X-Forwarded-*.
proxy_http_version 1.1;
proxy_set_header Host              $http_host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $http_host;
proxy_set_header Upgrade           $http_upgrade;
proxy_set_header Connection        $connection_upgrade;
# Subidas: adjuntos de ERPNext (su propio nginx admite 50m), imagenes e importaciones de InvenTree, logos de Pretix.
client_max_body_size 50m;
# Informes y generacion de PDF pueden tardar; ERPNext usa 120 s en su nginx (PROXY_READ_TIMEOUT).
proxy_read_timeout 120s;
proxy_send_timeout 120s;
proxy_connect_timeout 5s;
# Sin buffer de peticion: las subidas grandes van directas a la aplicacion.
proxy_request_buffering off;
# Redirecciones propias (la de openvpms) relativas: nginx escucha en el 80 del contenedor, y con HTTP_PORT distinto de 80
# una redireccion absoluta mandaria al navegador a un puerto equivocado.
absolute_redirect off;

server {
    listen 80 default_server;
    server_name _;
    default_type text/plain;
    charset utf-8;

    # Sonda del healthcheck del contenedor (docker-compose.yml).
    location = /salud {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 404 "Reserva Viva: este nombre no corresponde a ninguna aplicacion de la intranet.\nUsa openvpms.reservaviva.lan, pretix.reservaviva.lan, inventree.reservaviva.lan o rrhh.reservaviva.lan.\n";
    }
}

server {
    listen 80;
    server_name openvpms.reservaviva.lan;

    # OpenVPMS vive en /openvpms/: la raiz del nombre lleva ahi.
    location = / {
        return 302 /openvpms/;
    }

    location / {
        proxy_pass http://${NET_INFRA}.24:8080;
    }
}

server {
    listen 80;
    server_name pretix.reservaviva.lan;

    location / {
        proxy_pass http://${NET_INFRA}.21:80;
    }
}

server {
    listen 80;
    server_name inventree.reservaviva.lan;

    location / {
        proxy_pass http://${NET_INFRA}.22:8000;
    }
}

server {
    listen 80;
    server_name rrhh.reservaviva.lan;

    location / {
        proxy_pass http://${NET_INFRA}.25:8080;
    }
}
