  "cards": [
    {
      "dot": "cyan",
      "title": "3 PCs, 1 switch, sin Internet",
      "items": [
        "PC-1 en puerto access; PC-2 y PC-3 en trunk 802.1Q con dos VLANs cada uno",
        "Ningún equipo tiene ruta por defecto a Internet"
      ]
    },
    {
      "dot": "emerald",
      "title": "Redes macvlan por VLAN",
      "items": [
        "Cada contenedor de VLAN tiene IP real dentro de ella, no NAT",
        "Las piezas internas de ERPNext viven en un bridge privado y no salen al switch"
      ]
    },
    {
      "dot": "violet",
      "title": "VLAN 99 transversal",
      "items": [
        "OpenLDAP (389 y LDAPS 636), bind9 (53) y NTP (123) sirven a las 4 VLANs de negocio",
        "LDAPS usa una CA interna de scripts/generar-certificados.sh; su ca.crt se copia a PC-1 y PC-2"
      ]
    },
    {
      "dot": "amber",
      "title": "Enrutamiento entre VLANs",
      "items": [
        "Switch L3: aplica las ACLs con SVIs propias",
        "Switch L2 puro: PC-3 hace de router-on-a-stick para toda la matriz"
      ]
    }
  ]
