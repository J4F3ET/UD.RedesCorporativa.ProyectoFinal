.env
# CA interna, certificado LDAPS y sus claves: cada instalacion genera los suyos (servicios/ca/generar-certificados.sh)
servicios/ca/certs/
# Zonas DNS (vista interna y vista lan) y ACL de la vista interna, generadas desde las plantillas por levantar-sistema.sh
servicios/bind9/zones/db.reservaviva.lan
servicios/bind9/zones/db.reservaviva.lan.vista-lan
servicios/bind9/zones/acl-interna.conf
servicios/bind9/zones/*.tmp
# LDIF del primer arranque de OpenLDAP, con los hashes de las claves de sistema/test.env (levantar-sistema.sh preparar)
servicios/openldap/generado/

# Salidas de levantar-sistema.sh verificar
sistema/resultados/

# Worktrees y ficheros locales de sesiones de agentes
.claude/
