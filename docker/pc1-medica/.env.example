# Copiar a ".env" en esta misma carpeta y editar los valores.
# NUNCA commitear el archivo ".env" (ya está en .gitignore).

# Nombre de la tarjeta de red de este PC (ver tutorial, paso "Identificar la tarjeta de red").
# Si no sabes cuál es, casi siempre funciona dejarlo en "eth0".
IFACE=eth0

# Contraseña de la base de datos de OpenVPMS. Cámbiala por una propia.
OPENVPMS_DB_ROOT_PASSWORD=cambiar-esta-clave

# Contraseña del usuario "openvpms" de la base de datos (la crea el primer arranque). Cámbiala.
OPENVPMS_DB_PASSWORD=cambiar-esta-clave-2

# Contraseña del usuario "admin" de OpenVPMS. Cámbiala. Debe tener mínimo 8 caracteres con mayúscula,
# minúscula, número y un carácter especial (por ejemplo !); si no, OpenVPMS no arranca.
OPENVPMS_ADMIN_PASSWORD=Cambiar-Clave-3!
