# Copiar a ".env" en esta misma carpeta y editar los valores.
# NUNCA commitear el archivo ".env" (ya está en .gitignore).

# Nombre de la tarjeta de red de este PC (ver tutorial, paso "Identificar la tarjeta de red").
# Si no sabes cuál es, casi siempre funciona dejarlo en "eth0".
IFACE=eth0

# Contraseñas de las bases de datos de Pretix e InvenTree. Cámbialas por unas propias.
PRETIX_DB_PASSWORD=cambiar-esta-clave
INVENTREE_DB_PASSWORD=cambiar-esta-clave

# Administrador inicial de InvenTree (se crea solo al arrancar, si no existe).
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_PASSWORD=cambiar-esta-clave
INVENTREE_ADMIN_EMAIL=admin@reservaviva.local

# Administrador inicial de Pretix (lo crea deploy.sh, solo si no existe).
PRETIX_ADMIN_EMAIL=admin@reservaviva.local
PRETIX_ADMIN_PASSWORD=cambiar-esta-clave
