# Copiar a ".env" en esta misma carpeta y editar los valores.
# NUNCA commitear el archivo ".env" (ya está en .gitignore).

# Nombre de la tarjeta de red de este PC (ver tutorial, paso "Identificar la tarjeta de red").
# Si no sabes cuál es, casi siempre funciona dejarlo en "eth0".
IFACE=eth0

# Dejar en "false" salvo que el equipo técnico haya confirmado que el switch
# del laboratorio NO soporta VLANs con routing (switch "L2 puro"). Si no
# sabes qué significa esto, pregúntale al equipo técnico antes de cambiarlo.
FALLBACK_L2=false

# Contraseña del administrador de OpenLDAP. Cámbiala por una propia.
LDAP_ADMIN_PASSWORD=cambiar-esta-clave

# ERPNext (RRHH). Cambia ambas claves por propias.
# El sitio "rrhh.reservaviva.local" se crea solo la primera vez (unos 5-10 min).
# Usuario inicial: Administrator, con la clave ERPNEXT_ADMIN_PASSWORD.
ERPNEXT_DB_ROOT_PASSWORD=cambiar-esta-clave-db
ERPNEXT_ADMIN_PASSWORD=cambiar-esta-clave-erp
ERPNEXT_SITE=rrhh.reservaviva.local
