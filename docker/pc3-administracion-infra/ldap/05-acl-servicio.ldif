# Permite a la cuenta de servicio svc-lectura buscar (leer) en todo el directorio. Sin esto, la ACL por
# defecto de la imagen solo deja a cada usuario leer su propia entrada y las aplicaciones no podrian buscar
# al usuario que intenta iniciar sesion. La regla de userPassword (indice 1) va antes: svc-lectura NO puede
# leer claves, solo autenticar contra ellas con un bind.
dn: olcDatabase={1}mdb,cn=config
changetype: modify
delete: olcAccess
olcAccess: {2}
-
add: olcAccess
olcAccess: {2}to * by self read by dn="cn=admin,dc=reservaviva,dc=local" write by dn.exact="cn=svc-lectura,ou=servicios,dc=reservaviva,dc=local" read by * none
