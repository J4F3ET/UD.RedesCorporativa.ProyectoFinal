; Zona interna reservaviva.local. Al editar, incrementar el serial.
$TTL 300
@       IN SOA  dns.reservaviva.local. admin.reservaviva.local. (
                2026091901 ; serial
                3600       ; refresh
                600        ; retry
                86400      ; expire
                300 )      ; negative TTL
        IN NS   dns.reservaviva.local.

; --- VLAN 99: infraestructura ---
dns         IN A 10.10.99.11
ldap        IN A 10.10.99.10
ntp         IN A 10.10.99.12

; --- VLAN 10: Médica ---
openvpms    IN A 10.10.10.10

; --- VLAN 20: Eventos/Ticketing ---
pretix      IN A 10.10.20.10

; --- VLAN 30: Inventario ---
inventree   IN A 10.10.30.10

; --- VLAN 40: RRHH ---
rrhh        IN A 10.10.40.10
