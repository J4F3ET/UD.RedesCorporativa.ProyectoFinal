  "cards": [
    {
      "dot": "cyan",
      "title": "3 PCs, 1 switch, sin Internet",
      "items": [
        "PC-1 va en puerto access (una sola VLAN)",
        "PC-2 y PC-3 van en puerto trunk 802.1Q (dos VLANs cada uno)",
        "Ningún equipo tiene ruta por defecto a Internet"
      ]
    },
    {
      "dot": "emerald",
      "title": "Redes macvlan por VLAN",
      "items": [
        "Cada contenedor tiene IP real dentro de su VLAN (macvlan), no NAT",
        "Un mismo PC físico puede tener 2 redes macvlan distintas (PC-2 y PC-3)"
      ]
    },
    {
      "dot": "violet",
      "title": "VLAN 99 es transversal",
      "items": [
        "OpenLDAP, DNS y NTP en PC-3 dan servicio a las 4 VLANs de negocio",
        "Comparten el mismo enlace trunk que ERPNext hacia el switch"
      ]
    },
    {
      "dot": "amber",
      "title": "Enrutamiento entre VLANs",
      "items": [
        "Si el switch es L3: aplica las ACLs con SVIs propias",
        "Si el switch es L2 puro: PC-3 asume router-on-a-stick para toda la matriz (ver diagrama de flujo de datos)"
      ]
    }
  ]
